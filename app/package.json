{
  "name": "onda-andes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Avisos locales por audio, disponibles sin internet.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-artifact.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "onda": {
    "offline": {
      "exclude": [
        "/public/data/initial-feed.json",
        "/public/data/replay-feed.json"
      ]
    }
  }
}
