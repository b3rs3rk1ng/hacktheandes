# Notas recordadas por árbol en el buzón de sospechas (opcional, desactivado por defecto).
# Exportar en el entorno del proceso orchard_server.py; el servidor no lee este archivo.
CACAO_REVIEW_MEMORY=0
# Clave de un proyecto Atomic Memory Cloud (amc_...). Sólo en el servidor; nunca en el navegador.
ATOMICMEMORY_API_KEY=
# Opcional. Por defecto https://api.atomicstrata.ai
ATOMICMEMORY_API_URL=
# Identificador estable del operador de este huerto: define el sujeto cacao-operator:<id>.
CACAO_REVIEW_MEMORY_OPERATOR_ID=
