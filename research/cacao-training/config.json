{
  "dataset": {
    "name": "CocoaMoniliaDataSet-v2",
    "original": "https://zenodo.org/records/17716661",
    "mirror_repo": "Project-AgML/cocoa_monilia_detection",
    "mirror_revision": "07aeef939a7009fc13202a812185607772759f2d",
    "license": "CC-BY-4.0"
  },
  "classes": ["h0", "m1", "m2", "m3"],
  "coco_sources": [
    {"group": "h0", "annotations": "dataset-audit/instances_h0.json"},
    {"group": "m1", "annotations": "dataset-audit/instances_m1.json"},
    {"group": "m2", "annotations": "dataset-audit/instances_m2.json"},
    {"group": "m3", "annotations": "dataset-audit/instances_m3.json"}
  ],
  "unknown_category_policy": "drop_image",
  "dimension_policy": "exact",
  "duplicate_box_iou": 0.9,
  "conflicting_box_iou": 0.8,
  "phash_distance": 4,
  "group_capture_day": true,
  "capture_patterns": [
    {"pattern": "(20[0-9]{6})[_-]?([0-9]{6})", "format": "%Y%m%d%H%M%S"},
    {"pattern": "^([0-9]{13})", "epoch_milliseconds": true}
  ],
  "split_fractions": {"train": 0.7, "val": 0.15, "test": 0.15},
  "seed": 20261018,
  "max_side": 1280,
  "training": {
    "model": "yolo11n.pt", "epochs": 50, "imgsz": 640,
    "batch": 16, "workers": 2, "device": 0, "patience": 12
  }
}
