{"data":{"id":"10.17632/ykbtpsyfv9.1","type":"dois","attributes":{"doi":"10.17632/ykbtpsyfv9.1","prefix":"10.17632","suffix":"ykbtpsyfv9.1","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Rengifo-Lozano, Diego","nameType":"Personal","givenName":"Diego","familyName":"Rengifo-Lozano","affiliation":["Universidad Nacional de San Martín"],"nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0009-0008-8868-3331","nameIdentifierScheme":"ORCID"}]},{"name":"Sánchez-Flores, Jhosep","nameType":"Personal","givenName":"Jhosep","familyName":"Sánchez-Flores","affiliation":["Universidad Nacional de San Martín"],"nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0009-0004-1553-4950","nameIdentifierScheme":"ORCID"}]}],"titles":[{"title":"Image Dataset of Healthy and Monilia-Infected Cocoa Pods for Disease Classification"}],"publisher":"Mendeley Data","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning"},{"subject":"Computer Engineering"}],"contributors":[],"dates":[{"date":"2026-10-08T11:17:20Z","dateType":"Issued"}],"language":null,"types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.17632/ykbtpsyfv9","resourceTypeGeneral":"Dataset","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rightsUri":"info:eu-repo/semantics/openAccess"},{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"This dataset contains a total of 2,184 labeled images of cocoa pods organized into two classes: healthy and Monilia-infected samples. The dataset includes 1,342 images corresponding to cocoa pods affected by Monilia and 842 images of healthy cocoa pods.\n\nThe dataset was developed to support research on the automatic identification and classification of Monilia disease in cocoa using computer vision, machine learning, and deep learning techniques. It can be used for binary image classification tasks, model training and validation, transfer learning experiments, and comparative evaluation of different artificial intelligence approaches for plant disease recognition.\n\nThe class distribution is as follows:\n\n- Monilia-infected cocoa pods: 1,342 images\n- Healthy cocoa pods: 842 images\n- Total: 2,184 images\n\nThis dataset may contribute to the development of automated tools for cocoa disease detection, crop health monitoring, precision agriculture, and decision-support systems aimed at improving the early identification and management of Monilia disease in cocoa production.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://data.mendeley.com/datasets/ykbtpsyfv9/1","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-10-08T11:17:22.000Z","registered":"2026-10-08T11:17:22.000Z","published":"2026","updated":"2026-10-08T11:17:22.000Z"},"relationships":{"client":{"data":{"id":"bl.mendeley","type":"clients"}},"provider":{"data":{"id":"elsevier","type":"providers"}},"media":{"data":{"id":"10.17632/ykbtpsyfv9.1","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.17632/ykbtpsyfv9","type":"dois"}]}}}}